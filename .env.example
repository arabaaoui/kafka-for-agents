# =============================================================================
# Kafka Retail Agents PoC — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- LLM Configuration — one block per agent -------------------------------
# Each agent is a real google-adk Agent and can use a DIFFERENT provider/model.
# Supported providers: openai, anthropic, gemini
# (all providers are routed through LiteLLM — see agents/common/adk_factory.py)

# All three agents below are OPTIONAL: leave the *_LLM_API_KEY empty to run
# that agent on its deterministic fallback (no LLM call at all).

# Detection Agent — scans stock messages for anomalies
# Empty key: publishes basic anomalies straight from the pre-filter, no LLM severity qualification.
DETECTION_LLM_PROVIDER=openai
DETECTION_LLM_MODEL=gpt-4o
DETECTION_LLM_API_KEY=sk-your-openai-key-here

# Decision Agent — applies the SKILL.md replenishment procedure
# Empty key: applies the default rule — supplier order (commande_fournisseur) — for every anomaly.
DECISION_LLM_PROVIDER=anthropic
DECISION_LLM_MODEL=claude-sonnet-4-20250514
DECISION_LLM_API_KEY=sk-ant-your-anthropic-key-here

# Execution Agent — executes tasks (transfer / supplier order)
# Empty key: fully deterministic (fixed 2s delay, 100% success, no LLM call at all).
EXECUTION_LLM_PROVIDER=gemini
EXECUTION_LLM_MODEL=gemini-2.5-pro
EXECUTION_LLM_API_KEY=

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- MCP Confluent ---
MCP_CONFLUENT_URL=http://mcp-confluent:3000

# --- Share Group Configuration ---
SHARE_GROUP_LOCK_DURATION_MS=30000
SHARE_GROUP_MAX_DELIVERY_ATTEMPTS=5

# --- Simulation ---
SIMULATION_SPEED=1.0
# 1.0 = real-time, 60.0 = 1 hour of data in 1 minute

# --- Detection threshold ---
# Ratio applied to each product's seuil_min to decide when it's an anomaly.
# 1.0 = alert exactly at seuil_min, 0.8 = alert only once stock < 80% of seuil_min.
STOCK_ALERT_THRESHOLD_RATIO=1.0
