# =============================================================================
# Kafka Retail Agents PoC — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- LLM Provider (required) ---
# Supported: openai, anthropic, gemini
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
LLM_API_KEY=sk-ant-your-key-here

# For OpenAI:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-your-key-here

# For Gemini:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-pro
# LLM_API_KEY=your-key-here

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- MCP Confluent ---
MCP_CONFLUENT_URL=http://mcp-confluent:3000

# --- Share Group Configuration ---
SHARE_GROUP_LOCK_DURATION_MS=30000
SHARE_GROUP_MAX_DELIVERY_ATTEMPTS=5

# --- Simulation ---
SIMULATION_SPEED=1.0
# 1.0 = real-time, 60.0 = 1 hour of data in 1 minute